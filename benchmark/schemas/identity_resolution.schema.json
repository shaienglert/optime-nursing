{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentityResolution",
  "type": "object",
  "required": ["matches", "summary"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommended_name", "match_status"],
        "properties": {
          "match_status": {"enum": ["CONFIRMED_MATCH", "PROBABLE_MATCH_REVIEW_REQUIRED", "NO_MATCH", "AMBIGUOUS"]}
        }
      }
    }
  }
}
